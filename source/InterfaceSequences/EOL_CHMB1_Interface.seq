ConditionExpr = "Parameters.DUT == \"DUT1\"//RunState.TestSockets.MyIndex == 0"
%COMMENT = "Let's say that Test Soscket 0 is Master, and Test Socket 1 will wait for him to finish this task"

[DEF, SF.Seq[6].Main[0]]
%NAME = "If"

[SF.Seq[6].Main[1].TS]
Id = "ID#:ULxiYnv67xG53dQli0T1uC"
PostExpr Line0001 = "StationGlobals.Automation.SystemControl.CHMB1.TerminationInCHMB = False,\nStationGlobals.Automation.SystemControl.CHMB1."
PostExpr Line0002 = "Error = False"

[DEF, SF.Seq[6].Main[1]]
%NAME = "ResetTermintion and Error in Sequence to False"

[SF.Seq[6].Main[2].TS]
Id = "ID#:HAcp7HD67xG53dQli0T1uC"

[SF.Seq[6].Main[2]]
ConditionExpr Line0001 = "StationGlobals.SequenceStates[0] == Enums.SEQUENCE_STATES.ERROR || StationGlobals.SequenceStates[1] == Enums.SEQUENCE_ST"
ConditionExpr Line0002 = "ATES.ERROR"
%COMMENT Line0001 = "StationGlobals.SequenceStates[\"CHMB1_DUT1\"] == Enums.SEQUENCE_STATE.ERROR || StationGlobals.SequenceStates[\"CHMB1_DUT"
%COMMENT Line0002 = "2\"] == Enums.SEQUENCE_STATE.ERROR"

[DEF, SF.Seq[6].Main[2]]
%NAME = "If"

[SF.Seq[6].Main[3].TS]
Id = "ID#:HQcp7HD67xG53dQli0T1uC"
PostExpr = "StationGlobals.Automation.SystemControl.CHMB1.Error= True"

[DEF, SF.Seq[6].Main[3]]
%NAME = "Set Error in Sequence to True (In one of the Operations ERROR happend)"

[SF.Seq[6].Main[4].TS]
Id = "ID#:Hgcp7HD67xG53dQli0T1uC"

[SF.Seq[6].Main[4]]
ConditionExpr Line0001 = "StationGlobals.SequenceStates[0] == Enums.SEQUENCE_STATES.TERMINATED || StationGlobals.SequenceStates[1] == Enums.SEQUEN"
ConditionExpr Line0002 = "CE_STATES.TERMINATED"

[DEF, SF.Seq[6].Main[4]]
%NAME = "Else If"

[SF.Seq[6].Main[5].TS]
Id = "ID#:Hwcp7HD67xG53dQli0T1uC"
PostExpr = "StationGlobals.Automation.SystemControl.CHMB1.TerminationInCHMB = True"

