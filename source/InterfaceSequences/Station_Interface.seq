[SF.Seq[4].Setup[29]]
InitializationExpr Line0001 = "Locals.TestSocket = (StationGlobals.Automation.SystemControl.CHMB1.TestCHMB1 ? 0 : 2 ) // start from 0 if CHMB1 is teste"
InitializationExpr Line0002 = "d, if not initialize only CHMB2"
ConditionExpr = "Locals.TestSocket < ((StationGlobals.Automation.SystemControl.CHMB2.TestCHMB2 ) ? Locals.NumberOfTestSockets : 2 ) "
IncrementExpr = "Locals.TestSocket += 1"
CustomLoop = True
%COMMENT = "Normal operation with ini file"

[DEF, SF.Seq[4].Setup[29]]
%NAME = "For"

[SF.Seq[4].Setup[30].TS]
Id = "ID#:LEBNbHic8RGN7qQctBT8oA"
PostExpr = "StationGlobals.Automation.NOK_Counter[Locals.TestSocket] = 0"

[DEF, SF.Seq[4].Setup[30]]
%NAME = "Reset NOK counter"

[SF.Seq[4].Setup[31].TS]
Id = "ID#:K0BNbHic8RGN7qQctBT8oA"

