PostExpr Line0004 = "DI_Running_Channel = 3, //  when starting from 0\nStationGlobals.Automation.Motor.DUT2.Reference = StationGlobals.Refere"
PostExpr Line0005 = "nces.DIO.Port_References.DO_Card0_Port0,\nStationGlobals.Automation.Motor.DUT2.Channels.Enable = 3,\nStationGlobals.Auto"
PostExpr Line0006 = "mation.Motor.DUT2.Channels.Target_Bit0 = 4,\nStationGlobals.Automation.Motor.DUT2.Channels.Target_Bit1 = 5,\nStationGlob"
PostExpr Line0007 = "als.Automation.Motor.DUT2.DI_Running_Channel = 4, //  when starting from 0\n//CHMB2 is from Port 1\nStationGlobals.Autom"
PostExpr Line0008 = "ation.Motor.DUT3.Reference = StationGlobals.References.DIO.Port_References.DO_Card0_Port1,\nStationGlobals.Automation.Mo"
PostExpr Line0009 = "tor.DUT3.Channels.Enable = 0,\nStationGlobals.Automation.Motor.DUT3.Channels.Target_Bit0 = 1,\nStationGlobals.Automation"
